{
  "name": "project-server",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev:api1": "cross-env PORT=3001 nodemon --exec ts-node src/index.ts",
    "dev:api2": "cross-env PORT=3002 nodemon --exec ts-node src/index.ts",
    "dev:api3": "cross-env PORT=3003 nodemon --exec ts-node src/index.ts",
    "dev:lb": "cross-env LB_PORT=4000 LB_STRATEGY=round-robin nodemon --exec ts-node src/loadBalancer.ts",
    "dev:scaled": "concurrently -n api1,api2,api3,lb -c blue,green,yellow,magenta \"npm run dev:api1\" \"npm run dev:api2\" \"npm run dev:api3\" \"npm run dev:lb\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
